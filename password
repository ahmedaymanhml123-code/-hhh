        "import random\n",
        "import string\n",
        "\n",
        "# المستخدم يحدد الطول\n",
        "length = int(input(\"ادخل طول كلمة السر: \"))\n",
        "\n",
        "# اختيار نوع الباسورد\n",
        "print(\"اختار نوع كلمة السر:\")\n",
        "print(\"1 - حروف فقط\")\n",
        "print(\"2 - حروف + ارقام\")\n",
        "print(\"3 - حروف + ارقام + رموز\")\n",
        "\n",
        "choice = input(\"اختيارك: \")\n",
        "\n",
        "if choice == \"1\":\n",
        "    characters = string.ascii_letters\n",
        "elif choice == \"2\":\n",
        "    characters = string.ascii_letters + string.digits\n",
        "elif choice == \"3\":\n",
        "    characters = string.ascii_letters + string.digits + string.punctuation\n",
        "else:\n",
        "    print(\"اختيار غلط\")\n",
        "    characters = string.ascii_letters\n",
        "\n",
        "# توليد الباسورد\n",
        "password = ''.join(random.choice(characters) for i in range(length))\n",
        "\n",
        "print(\"🔐 كلمة السر:\", password)\n",
        "again = input(\"تحب تعمل باسورد تاني؟ (y/n): \")\n",
        "if again == \"y\":\n",
        "    print(\"شغل الكود تاني\")\n",
